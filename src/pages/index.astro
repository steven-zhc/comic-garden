---
import Layout from '../components/Layout.astro'
import Strip from '../components/Strip.astro'
import { shelved } from '../lib'

const comics = shelved()
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Layout title="Comic Garden">
  {
    comics.map((comic) => (
      <article>
        <h2>
          <a href={`${base}/comics/${comic.id}/`}>{comic.title}</a>
        </h2>
        <Strip comic={comic} />
        <p class="meta">
          joke by {comic.submittedBy} · {comic.date}
        </p>
      </article>
    ))
  }
</Layout>

<style>
  article {
    margin-bottom: 48px;
  }
  h2 {
    margin: 0 0 10px;
  }
  h2 a {
    color: inherit;
    text-decoration: none;
  }
  .meta {
    color: #7a6f63;
    font-size: 14px;
  }
</style>
