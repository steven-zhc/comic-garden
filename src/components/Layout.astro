---
interface Props {
  title: string
}
const { title } = Astro.props
const home = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href={home} class="brand">Comic Garden</a>
      <span class="tag">you bring the joke, an agent draws the strip</span>
      <a href={`${home}kit/`} class="kit">the kit</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font: 16px/1.5 system-ui, sans-serif;
    color: #2b2622;
    background: #fbf8f1;
  }
  header {
    display: flex;
    gap: 14px;
    align-items: baseline;
    flex-wrap: wrap;
    padding: 18px 24px;
    border-bottom: 2px solid #2b2622;
  }
  .brand {
    font-weight: 800;
    font-size: 22px;
    color: inherit;
    text-decoration: none;
  }
  .kit {
    margin-left: auto;
  }
  .tag {
    color: #7a6f63;
  }
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px;
  }
  a {
    color: #2f6f3e;
  }
</style>
